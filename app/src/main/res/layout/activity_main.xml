<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/md_theme_background"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- App Brand Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@drawable/bg_pill_badge"
                android:padding="8dp"
                android:src="@android:drawable/ic_dialog_map"
                app:tint="@color/rapido_yellow" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-black"
                    android:text="RAPIDO ASSISTANT"
                    android:textColor="@color/hud_text_primary"
                    android:textSize="20sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Smart Automation &amp; Heads-Up Assistant"
                    android:textColor="@color/hud_text_secondary"
                    android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Top Quick Launch Simulator Banner -->
        <Button
            android:id="@+id/btnQuickLaunchSimulator"
            style="@style/Widget.Material3.Button"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="16dp"
            android:backgroundTint="@color/rapido_yellow"
            android:fontFamily="sans-serif-black"
            android:letterSpacing="0.05"
            android:text="🚀 LAUNCH RIDE SIMULATOR"
            android:textColor="@color/rapido_black"
            android:textSize="15sp" />

        <!-- Permissions Section -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:fontFamily="sans-serif-bold"
            android:letterSpacing="0.06"
            android:text="SYSTEM PERMISSIONS"
            android:textColor="@color/hud_text_secondary"
            android:textSize="12sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_glass_card"
            android:orientation="vertical"
            android:padding="14dp">

            <!-- Accessibility Card -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Accessibility Service"
                        android:textColor="@color/hud_text_primary"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvAccessibilityStatus"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Required for screen scraping &amp; clicks"
                        android:textColor="@color/hud_text_secondary"
                        android:textSize="11sp" />
                </LinearLayout>

                <Button
                    android:id="@+id/btnEnableAccessibility"
                    style="@style/Widget.Material3.Button.TonalButton"
                    android:layout_width="wrap_content"
                    android:layout_height="38dp"
                    android:text="ENABLE"
                    android:textSize="11sp" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginVertical="10dp"
                android:background="@color/hud_border" />

            <!-- Overlay Card -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Display Over Other Apps"
                        android:textColor="@color/hud_text_primary"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvOverlayStatus"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Required for Cyberpunk HUD"
                        android:textColor="@color/hud_text_secondary"
                        android:textSize="11sp" />
                </LinearLayout>

                <Button
                    android:id="@+id/btnEnableOverlay"
                    style="@style/Widget.Material3.Button.TonalButton"
                    android:layout_width="wrap_content"
                    android:layout_height="38dp"
                    android:text="ENABLE"
                    android:textSize="11sp" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginVertical="10dp"
                android:background="@color/hud_border" />

            <!-- Notification Listener Card -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Notification Access"
                        android:textColor="@color/hud_text_primary"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvNotificationStatus"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Required for background lock-screen pings"
                        android:textColor="@color/hud_text_secondary"
                        android:textSize="11sp" />
                </LinearLayout>

                <Button
                    android:id="@+id/btnEnableNotification"
                    style="@style/Widget.Material3.Button.TonalButton"
                    android:layout_width="wrap_content"
                    android:layout_height="38dp"
                    android:text="ENABLE"
                    android:textSize="11sp" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginVertical="10dp"
                android:background="@color/hud_border" />

            <!-- Restricted Settings Help for Android 13/14/15 -->
            <LinearLayout
                android:id="@+id/cardRestrictedHelp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_glass_card"
                android:padding="10dp"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="⚠️ Restricted Setting Warning (Android 13+)"
                    android:textColor="@color/hud_amber"
                    android:textStyle="bold"
                    android:textSize="12sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="If Accessibility says 'Restricted setting', tap below to open App Info, tap the 3 dots in the top-right corner, and choose 'Allow restricted settings'."
                    android:textColor="@color/hud_text_secondary"
                    android:textSize="11sp" />

                <Button
                    android:id="@+id/btnOpenAppInfo"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="match_parent"
                    android:layout_height="38dp"
                    android:layout_marginTop="8dp"
                    android:text="OPEN APP INFO (UNLOCK RESTRICTED)"
                    android:textColor="@color/hud_neon_green"
                    android:textSize="10sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Driver Preferences Section -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:fontFamily="sans-serif-bold"
            android:letterSpacing="0.06"
            android:text="DRIVER PREFERENCES"
            android:textColor="@color/hud_text_secondary"
            android:textSize="12sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_glass_card"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Minimum Fare -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Minimum Fare"
                    android:textColor="@color/hud_text_primary"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/tvMinFareValue"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-bold"
                    android:text="₹40"
                    android:textColor="@color/hud_neon_green"
                    android:textSize="16sp" />
            </LinearLayout>

            <com.google.android.material.slider.Slider
                android:id="@+id/sliderMinFare"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:valueFrom="20"
                android:valueTo="200"
                android:stepSize="5"
                android:value="40"
                app:thumbColor="@color/rapido_yellow"
                app:trackColorActive="@color/rapido_yellow" />

            <!-- Max Pickup Distance -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Maximum Pickup Distance"
                    android:textColor="@color/hud_text_primary"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/tvMaxPickupValue"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-bold"
                    android:text="3.0 km"
                    android:textColor="@color/hud_cyan"
                    android:textSize="16sp" />
            </LinearLayout>

            <com.google.android.material.slider.Slider
                android:id="@+id/sliderMaxPickup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:valueFrom="1"
                android:valueTo="10"
                android:stepSize="0.5"
                android:value="3.0"
                app:thumbColor="@color/hud_cyan"
                app:trackColorActive="@color/hud_cyan" />

            <!-- Switches Row -->
            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/switchAutoAccept"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:checked="true"
                android:text="Auto-Accept Matching Rides"
                android:textColor="@color/hud_text_primary" />

            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/switchVoice"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:checked="true"
                android:text="Voice Announcements (Bluetooth)"
                android:textColor="@color/hud_text_primary" />

            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/switchOverlay"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:checked="true"
                android:text="Show Floating Cyberpunk HUD"
                android:textColor="@color/hud_text_primary" />

            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/switchSkipNight"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:checked="false"
                android:text="Skip Night Rides (10 PM - 6 AM)"
                android:textColor="@color/hud_text_primary" />

            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/switchAudioBugFix"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:checked="true"
                android:text="Auto-Fix Map Audio Bug (Mute-Unmute)"
                android:textColor="@color/hud_text_primary" />

            <!-- Home Location -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Home Location (Towards Home Filter):"
                android:textColor="@color/hud_text_secondary"
                android:textSize="12sp" />

            <EditText
                android:id="@+id/etHomeAddress"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="4dp"
                android:background="@drawable/bg_pill_badge"
                android:hint="Indiranagar, Bengaluru"
                android:paddingHorizontal="12dp"
                android:textColor="@color/hud_text_primary"
                android:textColorHint="@color/hud_text_secondary"
                android:textSize="13sp" />

            <Button
                android:id="@+id/btnSaveSettings"
                style="@style/Widget.Material3.Button"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="16dp"
                android:backgroundTint="@color/rapido_yellow"
                android:text="SAVE SETTINGS"
                android:textColor="@color/rapido_black"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Simulator & Test Section -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:fontFamily="sans-serif-bold"
            android:letterSpacing="0.06"
            android:text="RIDE OFFER SIMULATOR"
            android:textColor="@color/hud_text_secondary"
            android:textSize="12sp" />

        <Button
            android:id="@+id/btnOpenSimulator"
            style="@style/Widget.Material3.Button"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="8dp"
            android:backgroundTint="@color/hud_surface"
            android:fontFamily="sans-serif-black"
            android:letterSpacing="0.05"
            android:text="🚀 LAUNCH RIDE SIMULATOR"
            android:textColor="@color/hud_cyan"
            app:strokeColor="@color/hud_cyan"
            app:strokeWidth="1.5dp" />

        <Button
            android:id="@+id/btnTestAudioFix"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="24dp"
            android:text="🔊 TEST AUDIO BUG FIXER"
            android:textColor="@color/hud_text_primary"
            app:strokeColor="@color/hud_border" />
    </LinearLayout>
</ScrollView>
