<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/samsung_bg"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:animateLayoutChanges="true"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- TOP BAR: Navigation & Demo Badge -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingVertical="4dp">

            <Button
                android:id="@+id/btnBackToDashboard"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="wrap_content"
                android:layout_height="38dp"
                android:backgroundTint="@color/widget_tile_bg"
                android:text="← COCKPIT"
                android:textColor="@color/hud_text_primary"
                android:textSize="11sp"
                android:textStyle="bold" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/badgeLiveState"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_pill_badge"
                android:backgroundTint="#2638BDF8"
                android:paddingHorizontal="10dp"
                android:paddingVertical="4dp"
                android:text="● SIMULATOR ACTIVE"
                android:textColor="@color/samsung_blue"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Header -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Ride Simulator"
            android:textColor="@color/hud_text_primary"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="Real-time order evaluation &amp; auto-accept test"
            android:textColor="@color/hud_text_secondary"
            android:textSize="12sp" />

        <!-- SCENARIO CHIPS (HORIZONTAL SCROLL) -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:letterSpacing="0.06"
            android:text="TEST SCENARIO PRESETS"
            android:textColor="@color/hud_text_secondary"
            android:textSize="11sp"
            android:textStyle="bold" />

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/chipPrime"
                    style="@style/Widget.Material3.Button.TonalButton"
                    android:layout_width="wrap_content"
                    android:layout_height="38dp"
                    android:layout_marginEnd="6dp"
                    android:backgroundTint="#2600F5A0"
                    android:text="⚡ Prime Surge (₹145)"
                    android:textColor="@color/samsung_mint"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/chipTrap"
                    style="@style/Widget.Material3.Button.TonalButton"
                    android:layout_width="wrap_content"
                    android:layout_height="38dp"
                    android:layout_marginEnd="6dp"
                    android:backgroundTint="#26FF3366"
                    android:text="🛑 Money Trap (₹35)"
                    android:textColor="@color/samsung_ruby"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/chipMarginal"
                    style="@style/Widget.Material3.Button.TonalButton"
                    android:layout_width="wrap_content"
                    android:layout_height="38dp"
                    android:layout_marginEnd="6dp"
                    android:backgroundTint="#26FBBF24"
                    android:text="⚠️ Marginal (₹65)"
                    android:textColor="@color/samsung_amber"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/chipRain"
                    style="@style/Widget.Material3.Button.TonalButton"
                    android:layout_width="wrap_content"
                    android:layout_height="38dp"
                    android:backgroundTint="#2638BDF8"
                    android:text="🌧️ Rain Surge (₹210)"
                    android:textColor="@color/samsung_blue"
                    android:textSize="11sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </HorizontalScrollView>

        <!-- LIVE RAPIDO OFFER CARD (COCKPIT WIDGET) -->
        <LinearLayout
            android:id="@+id/cardMockRide"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_hero_gradient_card"
            android:orientation="vertical"
            android:padding="18dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_pill_badge"
                    android:backgroundTint="@color/rapido_yellow"
                    android:paddingHorizontal="8dp"
                    android:paddingVertical="3dp"
                    android:text="RAPIDO OFFER"
                    android:textColor="@color/rapido_black"
                    android:textSize="10sp"
                    android:textStyle="bold" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1" />

                <TextView
                    android:id="@+id/tvTimerCountdown"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="⏱️ 15s"
                    android:textColor="@color/samsung_amber"
                    android:textSize="12sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Fare Display -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvMockFare"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-black"
                    android:text="₹145"
                    android:textColor="#FFFFFF"
                    android:textSize="32sp" />

                <TextView
                    android:id="@+id/tvMockRate"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:background="@drawable/bg_pill_badge"
                    android:backgroundTint="#2600F5A0"
                    android:paddingHorizontal="8dp"
                    android:paddingVertical="3dp"
                    android:text="₹48.3 / km"
                    android:textColor="@color/samsung_mint"
                    android:textSize="11sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Progress Bar Countdown -->
            <ProgressBar
                android:id="@+id/progressBarCountdown"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="4dp"
                android:layout_marginTop="8dp"
                android:max="100"
                android:progress="100"
                android:progressTint="@color/samsung_amber" />

            <!-- Pickup and Drop Info Widgets -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="horizontal">

                <!-- Pickup Widget Tile -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="4dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_widget_tile"
                    android:orientation="vertical"
                    android:padding="10dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="📍 PICKUP"
                        android:textColor="@color/hud_text_tertiary"
                        android:textSize="10sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvMockPickup"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="1.1 km (3 mins)"
                        android:textColor="@color/hud_text_primary"
                        android:textSize="12sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- Drop Widget Tile -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_widget_tile"
                    android:orientation="vertical"
                    android:padding="10dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🏁 DESTINATION"
                        android:textColor="@color/hud_text_tertiary"
                        android:textSize="10sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvMockDrop"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:text="Indiranagar 100ft Rd"
                        android:textColor="@color/hud_text_primary"
                        android:textSize="12sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>

            <!-- SMART AI HUD EVALUATION CARD -->
            <LinearLayout
                android:id="@+id/cardAiEvaluation"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_widget_tile"
                android:orientation="vertical"
                android:padding="12dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tvAiRecommendationBadge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_pill_badge"
                        android:backgroundTint="#2600F5A0"
                        android:paddingHorizontal="8dp"
                        android:paddingVertical="3dp"
                        android:text="🛡️ AI EVALUATION: HIGH PROFIT"
                        android:textColor="@color/samsung_mint"
                        android:textSize="10sp"
                        android:textStyle="bold" />

                    <View
                        android:layout_width="0dp"
                        android:layout_height="1dp"
                        android:layout_weight="1" />

                    <TextView
                        android:id="@+id/tvAiScore"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Score: 94/100"
                        android:textColor="@color/samsung_mint"
                        android:textSize="11sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvMockResultStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="Eligible for Auto-Accept: Deadhead under 3.0km, Fare above ₹40"
                    android:textColor="@color/hud_text_secondary"
                    android:textSize="11sp" />
            </LinearLayout>

            <!-- Offer Actions -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnMockReject"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="46dp"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    android:text="✕ SKIP"
                    android:textColor="@color/samsung_ruby"
                    app:strokeColor="@color/samsung_ruby" />

                <Button
                    android:id="@+id/btnMockAccept"
                    style="@style/Widget.Material3.Button"
                    android:layout_width="0dp"
                    android:layout_height="46dp"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:backgroundTint="@color/samsung_mint"
                    android:text="⚡ ACCEPT"
                    android:textColor="#080B12"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

        <!-- CUSTOM SIMULATION PARAMETERS (WIDGET TILE) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_samsung_card"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:letterSpacing="0.06"
                android:text="CUSTOM RIDE PARAMETERS"
                android:textColor="@color/hud_text_secondary"
                android:textSize="11sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Fare (₹)"
                        android:textColor="@color/hud_text_secondary"
                        android:textSize="11sp" />

                    <EditText
                        android:id="@+id/etSimFare"
                        android:layout_width="match_parent"
                        android:layout_height="40dp"
                        android:layout_marginTop="4dp"
                        android:background="@drawable/bg_widget_tile"
                        android:inputType="numberDecimal"
                        android:paddingHorizontal="10dp"
                        android:text="145"
                        android:textColor="@color/hud_text_primary"
                        android:textSize="13sp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Pickup (km)"
                        android:textColor="@color/hud_text_secondary"
                        android:textSize="11sp" />

                    <EditText
                        android:id="@+id/etSimPickup"
                        android:layout_width="match_parent"
                        android:layout_height="40dp"
                        android:layout_marginTop="4dp"
                        android:background="@drawable/bg_widget_tile"
                        android:inputType="numberDecimal"
                        android:paddingHorizontal="10dp"
                        android:text="1.1"
                        android:textColor="@color/hud_text_primary"
                        android:textSize="13sp" />
                </LinearLayout>
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="Drop Destination"
                android:textColor="@color/hud_text_secondary"
                android:textSize="11sp" />

            <EditText
                android:id="@+id/etSimDrop"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:layout_marginTop="4dp"
                android:background="@drawable/bg_widget_tile"
                android:paddingHorizontal="10dp"
                android:text="Indiranagar 100ft Road"
                android:textColor="@color/hud_text_primary"
                android:textSize="13sp" />

            <Button
                android:id="@+id/btnSimulateCustom"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="match_parent"
                android:layout_height="42dp"
                android:layout_marginTop="12dp"
                android:backgroundTint="@color/samsung_blue"
                android:text="SIMULATE CUSTOM ORDER"
                android:textColor="#080B12"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- HARDWARE & AUDIO DIAGNOSTIC TEST WIDGETS -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_samsung_card"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:letterSpacing="0.06"
                android:text="DIAGNOSTIC &amp; AUDIO TESTS"
                android:textColor="@color/hud_text_secondary"
                android:textSize="11sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnTriggerSimNotification"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="match_parent"
                android:layout_height="42dp"
                android:layout_marginTop="10dp"
                android:backgroundTint="@color/widget_tile_bg"
                android:text="🔔 PUSH SIMULATED RIDE ALERT"
                android:textColor="@color/samsung_blue"
                android:textSize="11sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnSimulateMapAudio"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="match_parent"
                android:layout_height="42dp"
                android:layout_marginTop="8dp"
                android:backgroundTint="@color/widget_tile_bg"
                android:text="🔊 TEST BLUETOOTH AUDIO CHIME"
                android:textColor="@color/samsung_mint"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="24dp" />

    </LinearLayout>
</ScrollView>
